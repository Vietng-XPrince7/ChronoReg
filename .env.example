# Gemini API configuration for ChronoReg RAG LLM generation
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini model configured in configs/rag.yaml
GEMINI_MODEL=gemini-2.5-flash

# Optional: set to 0 to disable automatic LLM generation on CLI / StudentHub Web UI when GEMINI_API_KEY is present
RAG_AUTO_LLM=1
